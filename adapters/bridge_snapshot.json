{
  "protocol": 1,
  "id": "atelier.bridge.snapshot",
  "name": "Unity bridge snapshot",
  "version": "1.0.0",
  "origin": "official",
  "sdk": {"protocol": 1, "range": ">=1 <2"},
  "targets": ["unity-project"],
  "resources": [
    {"id": "bridge.inspection", "type": "report", "mutable": false},
    {"id": "bridge.snapshot", "type": "snapshot", "mutable": false}
  ],
  "actions": [
    {"id": "inspect", "name": "Inspect current avatar", "class": "read", "inputs": {}, "outputs": ["bridge.inspection"], "changes": []},
    {"id": "preview", "name": "Photograph current avatar", "class": "preview", "inputs": {}, "outputs": ["bridge.snapshot"], "changes": []}
  ],
  "dependencies": [],
  "ui": {"category": "Diagnostics", "icon": "snapshot", "forms": []},
  "recovery": {"retry": true, "undo": false}
}
